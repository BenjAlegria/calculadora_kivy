
<CalcButton@Button>:
    font_size: '20sp'
    background_normal: ''
    background_color: 0.85, 0.85, 0.85, 1
    color: 0, 0, 0, 1

<CalculadoraLayout>:
    orientation: 'vertical'
    padding: 15
    spacing: 10
    md_bg_color: 1, 1, 1, 1

    MDBoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.22
        spacing: 2
        padding: 0, 0, 0, 5

        MDLabel:
            text: root.historial
            halign: 'right'
            valign: 'bottom'
            theme_text_color: 'Custom'
            text_color: 0.4, 0.4, 0.4, 1
            font_style: 'Body'
            size_hint_y: 0.35

        MDLabel:
            text: root.pantalla
            halign: 'right'
            valign: 'bottom'
            theme_text_color: 'Custom'
            text_color: 0, 0, 0, 1
            bold: True
            font_style: 'Display'
            size_hint_y: 0.65

    # --- Teclado: GridLayout de 4 columnas x 5 filas ---
    GridLayout:
        cols: 4
        rows: 5
        spacing: 8
        size_hint_y: 0.78

        CalcButton:
            text: 'C'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: 'CE'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '%'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '/'
            on_release: root.on_button_press(self.text)

        CalcButton:
            text: '7'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '8'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '9'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '*'
            on_release: root.on_button_press(self.text)

        CalcButton:
            text: '4'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '5'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '6'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '-'
            on_release: root.on_button_press(self.text)

        CalcButton:
            text: '1'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '2'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '3'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '+'
            on_release: root.on_button_press(self.text)

        CalcButton:
            text: '+/-'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '0'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '.'
            on_release: root.on_button_press(self.text)
        CalcButton:
            text: '='
            on_release: root.on_button_press(self.text)
